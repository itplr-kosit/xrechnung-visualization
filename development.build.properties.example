###
# XRECHNUNG VISUALISATION properties
#
# Customize these properties to develop with local dependencies.
##

##
# This value has to be same as ant basedir because basedir is not set in this context
#
# Please set this value first and with an absolute path.
##
#work.dir=/mnt/c/data/git-repos/xrechnung-visualisation

##
# Designates the specification version for which this visualisation is valid
##
#xrechnung.version.full=2.2.0

##
# Set PDF profile
##
#fop.config=${work.dir}/conf/fop.xconf

##
#
# Use local Validator Configuration XRechnung Repository
#
##

#validator.repository.dir=${FULL PATH TO}/validator-configuration-xrechnung/build

##
# Set this property in order to activate targets for local development
# Be aware the presence of this property determines some of the behavior independent of the value
#
# The testsuite is normally resolved as a Maven dependency from the XSE component repository
# (declared in pom.xml). Setting this property additionally overwrites the resolved archive
# with a build from your local xrechnung-testsuite clone, because a plain dist directory is
# not a Maven repository.
##
#develop.local.xr.testsuite=true
###
# Get latest XRechnung Testsuite distribution from your local git project
# Example is relative to this project directory in local file system
# The file name expected here is xrechnung-<xrechnung.version.full>-testsuite.zip
##
#xr.testsuite.download.url.prefix=file://${work.dir}/../xrechnung-testsuite/dist

##
# The testsuite and validator configuration versions are declared in pom.xml
# (xrechnung.testsuite.version, validator.configuration.version), not here.
##



