<?xml version="1.0" encoding="UTF-8"?>
<project basedir="." name="abu-validator-provider" default="provide-validator">

  <!-- 
  Provides Validator dependency either from most mature release destination 
  or from local build based Deployment:
    * 
 -->

  <property name="validator.major.version" value="1" />
  <property name="validator.minor.version" value="6" />

  <property name="validator.version"
    value="${validator.major.version}.${validator.minor.version}.3" />

  <property name="validator.jar"
    value="validator-${validator.version}-standalone.jar" />

  <property name="validator.download.url.prefix"
    value="https://repo1.maven.org/maven2/org/kosit/validator" />

  <property name="validator.zip" value="validator-${validator.version}.zip" />

  <target name="init">
    <echo message="Calling ${ant.project.name} init task (from ${ant.file})" />

    <fail message="Required property lib.dir not available">
      <condition>
        <not>
          <isset property="lib.dir" />
        </not>
      </condition>
    </fail>
    <mkdir dir="${lib.dir}" />
  </target>

  <target name="check-download-dir" depends="init">
    <fail message="Required property download.dir not available">
      <condition>
        <not>
          <isset property="download.dir" />
        </not>
      </condition>
    </fail>


    <mkdir dir="${download.dir}" />
  </target>


  <target name="retrieve-validator-from-local-build"
    depends="init" if="develop.local.validator">


    <get src="${validator.download.url.prefix}/target/${validator.jar}"
      dest="${lib.dir}/" verbose="true" skipexisting="true"
      usetimestamp="true" />
  </target>


  <!-- deprecated use maven central instaead -->
  <target name="retrieve-validator-from-github-release"
    depends="init, check-download-dir" unless="develop.local.validator">
    <fail>This target is not supported anymore. Use retrieve-validator-from-maven-central instaed </fail>

    <property name="download.url.full"
      value="https://github.com/itplr-kosit/validator/releases/download/v${validator.version}/${validator.zip}" />

    <echo
      message="Retrieving validator version=${validator.version} from ${download.url.full}" />

    <get src="${download.url.full}" dest="${download.dir}" verbose="true"
      skipexisting="true" usetimestamp="true" />
  </target>

  <target name="retrieve-validator-from-maven-central" depends="init"
    unless="develop.local.validator">
    <description>Download validator standalone jar into lib.dir</description>

    <property name="download.url.full"
      value="${validator.download.url.prefix}/${validator.version}/${validator.jar}" />

    <echo
      message="Retrieving validator version=${validator.version} from ${download.url.full}" />

    <get src="${download.url.full}" dest="${lib.dir}" verbose="true"
      skipexisting="true" usetimestamp="true" />
  </target>

  <target name="retrieve-validator"
    depends="init, retrieve-validator-from-local-build, retrieve-validator-from-maven-central">
    <!-- add check something was downloaded -->
  </target>

  <!-- deprecated use maven central instead -->
  <target name="provide-validator-from-github-release" depends="init"
    description="Provide KoSIT validator from maven central and add standalone jar to library directory">

    <fail>This target is not supported anymore. Use provide-validator-from-maven-central instaed </fail>
    <echo message="Unpacking Validator resources" />

    <unzip src="${download.dir}/${validator.zip}" dest="${lib.dir}">
      <patternset>
        <include name="**/${validator.jar}" />
      </patternset>
      <flattenmapper />
    </unzip>

    <unzip src="${lib.dir}/${validator.jar}" dest="${resource.dir}">
      <patternset>
        <include name="xsd/scenarios.xsd" />
      </patternset>
    </unzip>
  </target>

  <target name="provide-validator-from-maven-central"
    depends="init, retrieve-validator"
    description="Provide standalone jar from maven central" />



  <target name="provide-validator"
    depends="init, retrieve-validator, provide-validator-from-maven-central"
    description="Download KoSIT validation tool and add standalone jar to library directory" />


  <target name="provide-scenario-xsd" depends="provide-validator"
    description="Unpacking Validator scenario.xsd to resources ${resource.dir}">

    <fail
      message="Required property resoure.dir not available for extracting scenario.xsd">
      <condition>
        <not>
          <isset property="resource.dir" />
        </not>
      </condition>
    </fail>


    <echo
      message="Unpacking Validator scenario.xsd to resources ${resource.dir}" />

    <unzip src="${lib.dir}/${validator.jar}" dest="${resource.dir}">
      <patternset>
        <include name="xsd/scenarios.xsd" />
      </patternset>
    </unzip>


  </target>

</project>
